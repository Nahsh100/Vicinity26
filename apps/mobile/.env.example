# Base URL of the Vicinity API (no trailing slash). On a physical phone use your computer's LAN IP,
# e.g. http://192.168.1.20:4000. Android emulator: http://10.0.2.2:4000.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Web map style (MapLibre). Default: OpenFreeMap "liberty" (free, no key, OpenStreetMap data).
# To use another provider, paste its style URL, e.g. https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY
# Set to "off" to show the key-free radar view instead of a street map.
EXPO_PUBLIC_MAP_STYLE_URL=

# Native builds only (read by app.config.js at build time, not shipped to the web app):
# Google Maps SDK for Android key, restricted to package zm.vicinity.app + your signing SHA-1.
# iOS uses Apple Maps (no key). Expo Go works without it. Without it, Android store builds show the radar view.
GOOGLE_MAPS_ANDROID_API_KEY=

# Public web address used in shared links (provider profiles, organization invites) so they open for
# anyone, with or without the app. The web app itself uses its own address automatically.
EXPO_PUBLIC_WEB_URL=https://vicinityzambia.com
