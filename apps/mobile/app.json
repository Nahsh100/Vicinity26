{
  "expo": {
    "name": "Vicinity",
    "slug": "vicinity-zambia",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vicinity",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "zm.vicinity.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Vicinity uses your location to show services and products near you.",
        "NSPhotoLibraryUsageDescription": "Choose photos for your profile, listings and portfolio.",
        "NSCameraUsageDescription": "Take photos for your profile, listings and portfolio."
      }
    },
    "android": {
      "package": "zm.vicinity.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Vicinity",
      "shortName": "Vicinity",
      "description": "Find trusted local services and skills in your neighbourhood.",
      "themeColor": "#FFFFFF",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-font",
      "expo-splash-screen",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vicinity uses your location to show services and products near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your profile, listings and portfolio."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0EA88E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "8df1601c-25f1-4804-bd23-f62e29733347"
      },
      "androidMapsConfigured": false,
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "owner": "zamtel-developer"
  }
}
