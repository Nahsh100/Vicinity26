# ── Server ──
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed by CORS (Expo web dev server, admin portal).
CORS_ORIGINS=http://localhost:8081,http://localhost:3001
# Public base URL of this API, used for local-storage media URLs and email links.
API_PUBLIC_URL=http://localhost:4000
# Where email verification / password reset links point (the web app).
APP_PUBLIC_URL=http://localhost:8081

# ── Database (docker compose: port 5433) ──
DATABASE_URL=postgresql://vicinity:vicinity_dev_password@localhost:5433/vicinity
TEST_DATABASE_URL=postgresql://vicinity:vicinity_dev_password@localhost:5433/vicinity_test

# ── Auth ── generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ── Media storage ──
# local: files under apps/api/storage, served through signed API URLs (development only).
# r2:    Cloudflare R2 via the S3 API with presigned upload/download URLs.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_SIGNING_SECRET=change-me-storage-signing-secret
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vicinity-media
# Optional public bucket domain (custom domain or r2.dev) for public media. Private media always uses presigned URLs.
R2_PUBLIC_BASE_URL=

# ── Email (SMTP). Leave SMTP_HOST empty in development: emails are written to the API log instead. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Vicinity <no-reply@vicinity.co.zm>"

# ── Push notifications (Expo). Optional access token if "enhanced push security" is on. ──
EXPO_ACCESS_TOKEN=
PUSH_ENABLED=true

# ── Rate limiting ──
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# ── Bootstrap admin (used by the seed script only) ──
SEED_ADMIN_EMAIL=admin@vicinity.local
SEED_ADMIN_PASSWORD=ChangeMe123
# Set to true to also load demo providers and listings around Lusaka.
SEED_DEMO_DATA=true

# ── Payments: providers buy plans with mobile money ──
# none: payments switched off (the app still works). simulator: local/test only, no money moves.
# lenco: real collections (MTN, Airtel, Zamtel). Sandbox: LENCO_API_URL=https://sandbox.lenco.co/access/v2
PAYMENT_PROVIDER=simulator
SIMULATOR_WEBHOOK_SECRET=change-me-simulator-secret
LENCO_API_URL=https://api.lenco.co/access/v2
LENCO_SEC_KEY=
# Webhook signing key from the Lenco dashboard (required in production).
LENCO_WEBHOOK_SIGNATURE_KEY=
# Minutes a payer has to approve the USSD prompt before the payment expires.
PAYMENT_TTL_MINUTES=15

# ── Phone sign-in with SMS codes (ported from TUMA). Off unless PHONE_OTP_AUTH=true. ──
PHONE_OTP_AUTH=false
# 32+ random chars; mixed into code hashes. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTP_PEPPER=
# zamtel (production) | dev (code printed in the API log; refused in production) | none
SMS_DRIVER=dev
ZAMTEL_SMS_API_KEY=
ZAMTEL_SMS_BASE_URL=https://bulksms.zamtel.co.zm/api/v2.1/action/send
# Sender id registered with Zamtel (max 11 characters).
SMS_SENDER_ID=Vicinity
# Optional: 11-char Android SMS Retriever hash so the app can autofill its own code.
SMS_APP_HASH=
