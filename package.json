{
  "name": "vicinity",
  "private": true,
  "version": "0.1.0",
  "description": "Vicinity Zambia - Find. Connect. Support Local.",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "api": "pnpm --filter @vicinity/api",
    "mobile": "pnpm --filter @vicinity/mobile",
    "admin": "pnpm --filter @vicinity/admin",
    "shared": "pnpm --filter @vicinity/shared",
    "build:shared": "pnpm --filter @vicinity/shared build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  }
}
